+    static final class QueuedExecutor extends AbstractExecutorService {
+        private final Queue<Runnable> tasks=new ArrayDeque<>();private boolean shutdown;
+        public void execute(Runnable r){if(shutdown)throw new RejectedExecutionException();tasks.add(r);}
+        public void shutdown(){shutdown=true;}
+        public List<Runnable> shutdownNow(){shutdown=true;List<Runnable> out=new ArrayList<>(tasks);tasks.clear();return out;}
+        public boolean isShutdown(){return shutdown;}
+        public boolean isTerminated(){return shutdown&&tasks.isEmpty();}
+        public boolean awaitTermination(long time,TimeUnit unit){return isTerminated();}
+        void runPending() throws Exception {Runnable r=tasks.remove();Thread t=new Thread(r,"review-save-worker");t.start();t.join(10000);assertFalse("Save worker did not complete",t.isAlive());}
+    }
+    public static final class FileProvider extends ContentProvider {
+        final File file;
+        FileProvider(File file){this.file=file;}
