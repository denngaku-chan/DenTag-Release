+        }
+    }
+    private QueuedExecutor queueSave() throws Exception {
+        return queueSave(true);
+    }
+    private QueuedExecutor queueSave(boolean overwrite) throws Exception {
+        File opened=new File(activity.getCacheDir(),"review-opened.mp3");
+        File target=new File(activity.getFilesDir(),"review-document.mp3");
+        saveTarget=target;
+        byte[] bytes=Files.readAllBytes(new File(ActivityLifecycleTest.class.getResource("/tone.mp3").toURI()).toPath());
+        originalBytes=bytes;
+        Files.write(opened.toPath(),bytes);Files.write(target.toPath(),bytes);
+        Uri uri=Uri.parse("content://review/document/tone");
+        documentUri=uri;registerTarget(uri,target);
+        ReflectionHelpers.setField(activity,"source",opened);
+        ReflectionHelpers.setField(activity,"song",TagEngine.read(opened));
+        ReflectionHelpers.setField(activity,"displayName","tone.mp3");
+        Uri sourceUri=overwrite?uri:Uri.parse("content://review/document/original");
+        if(!overwrite){File original=new File(activity.getFilesDir(),"original.mp3");Files.write(original.toPath(),bytes);registerTarget(sourceUri,original);}
+        ReflectionHelpers.setField(activity,"sourceUri",sourceUri);
+        ReflectionHelpers.setField(activity,"sourceWritable",true);
+        invoke("fill",new Class<?>[0]);
+        EditText[] fields=ReflectionHelpers.getField(activity,"fields");fields[0].setText("Edited title");
+        QueuedExecutor executor=replaceWorker();
+        invoke("export",new Class<?>[]{Uri.class,boolean.class},uri,overwrite);
+        return executor;
+    }
+    @Test public void destroyedActivityMustNotShowSaveDialog() throws Exception {
+        QueuedExecutor executor=queueSave();
+        controller.pause().stop().destroy();assertTrue(activity.isDestroyed());
+        executor.runPending();
+        shadowOf(Looper.getMainLooper()).idle();
+        TextView status=ReflectionHelpers.getField(activity,"status");
+        assertEquals("Save status: "+status.getText(),"Edited title",TagEngine.read(saveTarget).values[0]);
+        assertNull("A save callback must not create a dialog for a destroyed Activity",ShadowAlertDialog.getLatestAlertDialog());
+    }
+    @Test public void recreatedEditorMustKeepItsWorkingFileWhenOldSaveCompletes() throws Exception {
+        QueuedExecutor executor=queueSave();
+        MainActivity old=activity;controller.recreate();activity=controller.get();assertTrue(old.isDestroyed());
+        assertTrue(ReflectionHelpers.<Boolean>getField(activity,"busy"));assertFalse(picker().isEnabled());
+        executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertEquals("Edited title",TagEngine.read(saveTarget).values[0]);
+        File liveSource=ReflectionHelpers.getField(activity,"source");
+        assertTrue("Recreated editor must have a readable working file",liveSource.isFile());
+        assertArrayEquals(Files.readAllBytes(saveTarget.toPath()),Files.readAllBytes(liveSource.toPath()));
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"dirty"));
+        // A second overwrite proves that the editor adopted the saved version, rather than a stale cache file.
+        EditText[] fields=ReflectionHelpers.getField(activity,"fields");fields[0].setText("Second save");
+        QueuedExecutor next=replaceWorker();invoke("export",new Class<?>[]{Uri.class,boolean.class},documentUri,true);
+        next.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertEquals("Second save",TagEngine.read(saveTarget).values[0]);
+    }
+    @Test public void completionBetweenStateSaveAndRecreationIsDeliveredToNewScreen() throws Exception {
+        QueuedExecutor executor=queueSave();File original=ReflectionHelpers.getField(activity,"source");
+        Bundle state=new Bundle();controller.saveInstanceState(state);
+        executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertTrue("Saved state still references this working file",original.isFile());
+        assertNull(ShadowAlertDialog.getLatestAlertDialog());
+        Object retained=activity.onRetainNonConfigurationInstance();controller.pause().stop().destroy();
+        controller=Robolectric.buildActivity(MainActivity.class);activity=controller.get();
+        shadowOf(activity).setLastNonConfigurationInstance(retained);controller.setup(state);
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertEquals("Edited title",ReflectionHelpers.<EditText[]>getField(activity,"fields")[0].getText().toString());
+        assertEquals("Edited title",TagEngine.read(ReflectionHelpers.<File>getField(activity,"source")).values[0]);
+    }
+    @Test public void repeatedRecreationRetainsOnlyOneSave() throws Exception {
+        QueuedExecutor executor=queueSave();controller.recreate().recreate();activity=controller.get();
+        executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertEquals("Edited title",TagEngine.read(ReflectionHelpers.<File>getField(activity,"source")).values[0]);
+        assertEquals("Edited title",TagEngine.read(saveTarget).values[0]);
+    }
+    @Test public void saveFailureAfterRecreationKeepsEditsAndOriginalWorkingFile() throws Exception {
+        QueuedExecutor executor=queueSave();
+        byte[] external=Arrays.copyOf(originalBytes,originalBytes.length+1);external[external.length-1]=42;
+        Files.write(saveTarget.toPath(),external);
+        controller.recreate();activity=controller.get();executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertArrayEquals(external,Files.readAllBytes(saveTarget.toPath()));
+        assertTrue(ReflectionHelpers.<File>getField(activity,"source").isFile());
+        assertTrue(ReflectionHelpers.<Boolean>getField(activity,"dirty"));assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertEquals("Edited title",ReflectionHelpers.<EditText[]>getField(activity,"fields")[0].getText().toString());
+    }
+    @Test public void recoverySurvivesRecreationAndWritesOriginalBytes() throws Exception {
+        byte[] bytes=Files.readAllBytes(new File(ActivityLifecycleTest.class.getResource("/tone.mp3").toURI()).toPath());
+        File backup=new File(activity.getFilesDir(),"overwrite-original.bin");Files.write(backup.toPath(),bytes);
+        File target=new File(activity.getFilesDir(),"recovered.mp3");Files.write(target.toPath(),new byte[0]);
+        Uri uri=Uri.parse("content://review/document/recovered");registerTarget(uri,target);
+        QueuedExecutor executor=replaceWorker();invoke("recover",new Class<?>[]{Uri.class},uri);
+        controller.recreate();activity=controller.get();executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertArrayEquals(bytes,Files.readAllBytes(target.toPath()));assertFalse(backup.exists());
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertNotNull(ShadowAlertDialog.getLatestAlertDialog());
+    }
+    @Test public void copySaveSurvivesRecreationAndPreservesWorkingAudio() throws Exception {
+        QueuedExecutor executor=queueSave(false);File original=ReflectionHelpers.getField(activity,"source");
+        controller.recreate();activity=controller.get();executor.runPending();shadowOf(Looper.getMainLooper()).idle();
+        assertEquals("Edited title",TagEngine.read(saveTarget).values[0]);
+        assertArrayEquals(originalBytes,Files.readAllBytes(original.toPath()));
+        assertEquals(original,ReflectionHelpers.<File>getField(activity,"source"));
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"dirty"));
+    }
+    @Test public void completionWhileBackgroundedWaitsUntilResume() throws Exception {
+        QueuedExecutor executor=queueSave();controller.pause().stop();
+        executor.runPending();shadowOf(Looper.getMainLooper()).idle();assertNull(ShadowAlertDialog.getLatestAlertDialog());
+        controller.restart().start().resume();
+        assertFalse(ReflectionHelpers.<Boolean>getField(activity,"busy"));
+        assertEquals("Edited title",TagEngine.read(ReflectionHelpers.<File>getField(activity,"source")).values[0]);
+        assertNotNull(ShadowAlertDialog.getLatestAlertDialog());
+    }
+}
